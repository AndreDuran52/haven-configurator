+import { lazy, Suspense, useMemo, useState } from 'react'
+import { useStore } from 'zustand'
+import { buildHaven } from './engine/buildHaven'
+import { createHavenStore } from './state/store'
+import { PlanView } from './views/PlanView'
+import { makeShopSheetPdf } from './export/shopSheet'
+
+// The ONLY path to three.js: a dynamic import behind the 3D toggle.
+const ThreeView = lazy(() => import('./three/ThreeView'))
+
+export default function HavenPage() {
+  const [store] = useState(() => createHavenStore())
+  const config = useStore(store, (s) => s.present)
+  const pieces = useMemo(() => buildHaven(config), [config])
+  const [view, setView] = useState<'plan' | '3d'>('plan')
+  return (
+    <div className="fixed inset-0 bg-canvas">
+      <button type="button" onClick={() => void makeShopSheetPdf(document.querySelector('svg')!)}>pdf</button>
+      <button type="button" onClick={() => setView(view === 'plan' ? '3d' : 'plan')}>toggle</button>
+      {view === 'plan' ? (
+        <PlanView pieces={pieces} />
+      ) : (
+        <Suspense fallback={<p>Loading 3D…</p>}>
+          <ThreeView pieces={pieces} />
+        </Suspense>
+      )}
+    </div>
+  )
+}
