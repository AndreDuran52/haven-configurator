+// Export path: jspdf + svg2pdf load only when the user taps Export.
+export async function makeShopSheetPdf(svg: SVGSVGElement): Promise<Blob> {
+  const [{ jsPDF }, { svg2pdf }] = await Promise.all([import('jspdf'), import('svg2pdf.js')])
+  const doc = new jsPDF({ orientation: 'landscape', unit: 'in', format: 'letter' })
+  await svg2pdf(svg, doc, { x: 0.5, y: 0.5, width: 10, height: 7.5 })
+  return doc.output('blob')
+}
