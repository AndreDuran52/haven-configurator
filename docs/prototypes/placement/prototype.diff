+import type { HavenConfig, Piece } from './types'
+
+export const STANDARD_U: HavenConfig = { schema: 1, shape: 'U', W: 188, L: 132, R: 132, D: 44, C: 60 }
+
+/** Stub: pure config -> pieces. */
+export function buildHaven(config: HavenConfig): Piece[] {
+  const { W, D, C } = config
+  return [
+    { id: 'w1', kind: 'wedge', x: 0, y: 0, w: C, d: C },
+    { id: 't1', kind: 'table', x: C, y: 0, w: 32, d: D },
+    { id: 'a1', kind: 'armless', x: C + 32, y: 0, w: W - 2 * C - 32, d: D },
+    { id: 'w2', kind: 'wedge', x: W - C, y: 0, w: C, d: C },
+  ]
+}
