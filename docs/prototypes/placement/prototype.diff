+import { createStore } from 'zustand/vanilla'
+import type { HavenConfig } from '../engine/types'
+import { STANDARD_U } from '../engine/buildHaven'
+
+export interface HavenState {
+  past: HavenConfig[]
+  present: HavenConfig
+  future: HavenConfig[]
+  set: (next: HavenConfig) => void
+  undo: () => void
+}
+
+export const createHavenStore = (initial: HavenConfig = STANDARD_U) =>
+  createStore<HavenState>((set) => ({
+    past: [],
+    present: initial,
+    future: [],
+    set: (next) => set((s) => ({ past: [...s.past, s.present], present: next, future: [] })),
+    undo: () =>
+      set((s) =>
+        s.past.length
+          ? { past: s.past.slice(0, -1), present: s.past[s.past.length - 1], future: [s.present, ...s.future] }
+          : s,
+      ),
+  }))
